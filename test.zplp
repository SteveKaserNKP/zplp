DEF SMALL_FONT 0N,15,18
DEF MED_FONT 0N,20,30
DEF LARGE_FONT 0N,30,40

DEF FULL_WIDTH_LINE 780,3,3,B,0

DEF LINEAR_BARCODE_CONFIG 2,2.7,10
DEF CODE39_CONFIG_VALUES N,N,50,N,N

BEGIN_DOCUMENT

    BEGIN_SECTION::Label/Printer Setup
        BEGIN_FIELD::SETUP::Label/Printer Setup
            DPMM 8
            DIMENSIONS 102, 63
            MARGINS 1,1,1,1
        END_FIELD
    END_SECTION

    BEGIN_SECTION::PART NO. BLOCK

        BEGIN_FIELD::TEXT::"Part No." text
            POSITION 0, 25
            FONT *MED_FONT
            TEXT PART NO.
        END_FIELD

        BEGIN_FIELD::TEXT::"(P)" text
            POSITION 0, 50
            FONT *SMALL_FONT
            TEXT (P)
        END_FIELD

        BEGIN_FIELD::TEXT::Part No. data
            POSITION 200, 50
            FONT *LARGE_FONT
            TEXT {PART_NO::3880069F A000M1}
        END_FIELD

        BEGIN_FIELD::LINEAR_BARCODE_CODE39::Part No. barcode
            POSITION 100,65
            LINEAR_BARCODE_CONFIG *LINEAR_BARCODE_CONFIG
            CODE39_CONFIG *CODE39_CONFIG_VALUES
            TEXT {PART_NO_BARCODE::P3880069F A000M1}
        END_FIELD

        BEGIN_FIELD::GRAPHIC_BOX::Line under Part No. field
            POSITION 0,122
            BOX *FULL_WIDTH_LINE
        END_FIELD

    END_SECTION: PART NO. BLOCK

    BEGIN_SECTION::COLOR/DESRIPTION/SUPPLIER LOT NO/SUPPLIER PART NO

        BEGIN_FIELD::TEXT::"Part No. Ext" text
            POSITION 0, 145
            FONT *MED_FONT
            TEXT PART NO. Ext
        END_FIELD

        BEGIN_FIELD::TEXT::"(C)" text
            POSITION 0, 170
            FONT *SMALL_FONT
            TEXT (C)
        END_FIELD

        BEGIN_FIELD::LINEAR_BARCODE_CODE39::Color barcode
            POSITION 0,185
            LINEAR_BARCODE_CONFIG *LINEAR_BARCODE_CONFIG
            CODE39_CONFIG *CODE39_CONFIG_VALUES
            TEXT {COLOR_BARCODE::NH911TS}
        END_FIELD

        BEGIN_FIELD::TEXT::Color Code text
            POSITION 200,170
            FONT *LARGE_FONT
            TEXT {COLOR::NH911TS}
        END_FIELD

        BEGIN_FIELD::GRAPHIC_BOX::Line between Color and Description/Supplier info
            POSITION 450,122
            BOX 3,122,3
        END_FIELD

        BEGIN_FIELD::TEXT::"DESCRIPTION" text
            POSITION 455,145
            FONT *MED_FONT
            TEXT DESCRIPTION
        END_FIELD

        BEGIN_FIELD::TEXT::Description data
            POSITION 460, 170
            FONT *SMALL_FONT
            TEXT {DESCRIPTION::COMPRESSOR}
        END_FIELD

        BEGIN_FIELD::GRAPHIC_BOX::Line under Description and Supplier info
            POSITION 450,175
            BOX 332,3,3
        END_FIELD

        BEGIN_FIELD::TEXT::"LOT #" text
            POSITION 455, 195
            FONT *SMALL_FONT
            TEXT LOT #
        END_FIELD

        BEGIN_FIELD::TEXT::LOT # data
            POSITION 460, 212
            FONT *SMALL_FONT
            TEXT {MFG_LOT_NO::12345}
        END_FIELD

        BEGIN_FIELD::TEXT::"SPLR PART #" text
            POSITION 455, 228
            FONT *SMALL_FONT
            TEXT SPLR PART #
        END_FIELD

        BEGIN_FIELD::TEXT::SPLR Part # data
            POSITION 460, 243
            FONT *SMALL_FONT
            TEXT {SUPPLIER_PART_NO::388006MA A000M1}
        END_FIELD

        BEGIN_FIELD::GRAPHIC_BOX::Line under Color and Description/Supplier info
            POSITION 0,244
            BOX *FULL_WIDTH_LINE
        END_FIELD

    END_SECTION: COLOR/DESRIPTION/SUPPLIER LOT NO/SUPPLIER PART NO

    BEGIN_SECTION::DC PART LEVEL/QUANTITY

        BEGIN_FIELD::TEXT::"D/C Part Level" text
            POSITION 0, 270
            FONT *MED_FONT
            TEXT D/C Part Level
        END_FIELD

        BEGIN_FIELD::TEXT::"(2P)" text
            POSITION 0, 290
            FONT *SMALL_FONT
            TEXT (2P)
        END_FIELD

        BEGIN_FIELD::LINEAR_BARCODE_CODE39::DC Part Level barcode
            POSITION 0,300
            LINEAR_BARCODE_CONFIG *LINEAR_BARCODE_CONFIG
            CODE39_CONFIG *CODE39_CONFIG_VALUES
            TEXT {DC_PART_LEVEL_BARCODE::2P01 35}
        END_FIELD

        BEGIN_FIELD::TEXT::DC Part Level text
            POSITION 200,290
            FONT *LARGE_FONT
            TEXT {DC_PART_LEVEL::21 35}
        END_FIELD

        BEGIN_FIELD::GRAPHIC_BOX::Line between Color and Description/Supplier info
            POSITION 450,244
            BOX 3,122,3
        END_FIELD

        BEGIN_FIELD::LINEAR_BARCODE_CODE39::Qty barcode
            POSITION 475,255
            LINEAR_BARCODE_CONFIG *LINEAR_BARCODE_CONFIG
            CODE39_CONFIG *CODE39_CONFIG_VALUES
            TEXT {QUANTITY_BARCODE::Q80}
        END_FIELD

        BEGIN_FIELD::TEXT::QUANTITY data
            POSITION 525,335
            FONT *LARGE_FONT
            TEXT {QUANTITY::80}
        END_FIELD

        BEGIN_FIELD::TEXT::"QUANTITY (Q)" text
            POSITION 475,360
            FONT *MED_FONT
            TEXT QUANTITY (Q)
        END_FIELD

        BEGIN_FIELD::GRAPHIC_BOX::Line under Color and Description/Supplier info
            POSITION 0,366
            BOX *FULL_WIDTH_LINE
        END_FIELD

    END_SECTION: DC PART LEVEL/QUANTITY

    BEGIN_SECTION::SERIAL NO

        BEGIN_FIELD::TEXT::"Serial" text
            POSITION 0,390
            FONT *MED_FONT
            TEXT SERIAL
        END_FIELD

        BEGIN_FIELD::TEXT::"1S" text
            POSITION 0,410
            FONT *SMALL_FONT
            TEXT (1S)
        END_FIELD

        BEGIN_FIELD::TEXT::Serial No data
            POSITION 175,410
            FONT *LARGE_FONT
            TEXT {SERIAL_NO::NKP00000-12345678}
        END_FIELD

        BEGIN_FIELD::LINEAR_BARCODE_CODE39::Serial No barcode
            POSITION 75,420
            LINEAR_BARCODE_CONFIG *LINEAR_BARCODE_CONFIG
            CODE39_CONFIG *CODE39_CONFIG_VALUES
            TEXT {SERIAL_NO_BARCODE::1SNKP0000012345678}
        END_FIELD

        BEGIN_FIELD::TEXT::Country of Origin
            POSITION 0,490
            FONT *SMALL_FONT
            TEXT {COUNTRY_OF_ORIGIN::Made in USA}
        END_FIELD

        BEGIN_FIELD::TEXT::Supplier Address
            POSITION 300,490
            FONT *SMALL_FONT
            TEXT {SUPPLIER_ADDRESS::777 S Kuther Rd Sidney, OH 45365}
        END_FIELD

    END_SECTION: SERIAL_NO

END_DOCUMENT