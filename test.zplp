DEF SMALL_FONT 0R,18,18
DEF MID_FONT 0R,20,30
DEF LARGE_FONT 0R,30,40

DEF TOP_MARGIN 20

DEF DEFAULT_BOX 3,780,3

DEF BARCODE_CONFIG_VALUES 2,2.7,8
DEF CODE39_CONFIG_VALUES R,N,50,N,N

BEGIN_DOCUMENT

    BEGIN_SETUP
        PRINT_WIDTH 507
        ZPL_MODE 2
        DOTS_PER_MM A
        BITMAP_CLEAR Y
        //MIRROR_IMAGE N
        //BACKFEED_SEQ N
        //REPRINT_AFTER_ERROR Y
        //LABEL_HOME 0,0
        //REVERSE_PRINT N
    END_SETUP

    BEGIN_SECTION: PART NO. BLOCK

        BEGIN_FIELD: "Part No." text
            TYPE TEXT
            POSITION 485, *TOP_MARGIN
            FONT *MID_FONT
            TEXT PART NO.
        END_FIELD

        BEGIN_FIELD: "(P)" text
            TYPE TEXT
            POSITION 460, *TOP_MARGIN
            FONT *MID_FONT
            TEXT (P)
        END_FIELD

        BEGIN_FIELD: Part No. data
            TYPE TEXT
            POSITION 460, 120
            FONT *LARGE_FONT
            TEXT {PART_NO::3880069F A000M1}
        END_FIELD

        BEGIN_FIELD: Part No. barcode
            TYPE BARCODE
            POSITION 400, 65
            LINEAR_BARCODE_CONFIG *BARCODE_CONFIG_VALUES
            LINEAR_BARCODE CODE39 *CODE39_CONFIG_VALUES
            TEXT {PART_NO_BARCODE::P3880069F A000M1}
        END_FIELD

        //BEGIN_FIELD Line under Part No. field
        //    TYPE GRAPHIC
        //    POSITION 380, 15
        //    BOX *DEFAULT_BOX
        //END_FIELD

    END_SECTION: PART NO. BLOCK

END_DOCUMENT